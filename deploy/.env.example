# Copy to deploy/.env and fill in. deploy/.env is git-ignored: the RPC
# URL may carry a provider key, and that key must never be committed or
# shipped in the website bundle (the website gets its own, public or
# domain-restricted, endpoint via the GitHub repository variables).

# ---- Osmosis RPC (Tendermint JSON-RPC) used by both services ----------
# A keyed provider URL (dRPC: https://lb.drpc.live/osmosis/<key>), a
# public endpoint (https://osmosis.drpc.org, https://osmosis-rpc.publicnode.com,
# https://rpc.osmosis.zone) or your own node (http://10.0.0.5:26657).
# Testnet while the mainnet contracts are in governance:
RPC_URL=https://rpc.osmotest5.osmosis.zone
# The profiles service defaults to RPC_URL; set this only to split them.
# PROFILES_RPC=

# ---- Indexer -----------------------------------------------------------
# The BlueChip factory contract. Only this contract may register pools.
# Testnet deployment today; replace with the mainnet factory on approval day.
FACTORY_ADDRESS=osmo1p93hcfzjnjfv0vtfxmunpqc25tq3p2vzh76hq3wxfz2zyayw4hzq4ac3vt
# First block to index. On mainnet this MUST be the block the factory was
# instantiated in (osmosisd q tx <instantiate txhash> | grep height) —
# the indexer walks every block from here and Osmosis mainnet has tens of
# millions of them. Must still be within the RPC node's unpruned range.
START_HEIGHT=1
NATIVE_DENOM=uosmo
POLL_INTERVAL_MS=1500
BATCH_SIZE=20
INDEXER_RATE_LIMIT_PER_MIN=300

# ---- Profiles service --------------------------------------------------
PROFILES_SUBSCRIPTION_DAYS=30
PROFILES_RATE_LIMIT_PER_MIN=300

# ---- Public hostnames (Caddy obtains TLS certificates for these) -------
INDEXER_HOST=indexer.example.com
PROFILES_HOST=profiles.example.com
ACME_EMAIL=you@example.com
